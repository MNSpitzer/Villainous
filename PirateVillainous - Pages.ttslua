{move_to={ 3.926941, 0.153829, 1.901071 }, json=[[{"GUID":"5df092","Name":"Custom_Tile","Transform":{"posX":-19.4530582,"posY":1.63382864,"posZ":18.9310722,"rotX":2.090433,"rotY":0.03948115,"rotZ":0.00168852473,"scaleX":1.47602439,"scaleY":1.0,"scaleZ":1.47602439},"Nickname":"Longship / Burned Longship","Description":"","GMNotes":"","AltLookAngle":{"x":0.0,"y":0.0,"z":0.0},"ColorDiffuse":{"r":0.309798956,"g":0.0,"b":0.007843138},"LayoutGroupSortIndex":0,"Value":0,"Locked":false,"Grid":true,"Snap":true,"IgnoreFoW":false,"MeasureMovement":false,"DragSelectable":true,"Autoraise":true,"Sticky":true,"Tooltip":true,"GridProjection":false,"HideWhenFaceDown":false,"Hands":false,"CustomImage":{"ImageURL":"https://steamusercontent-a.akamaihd.net/ugc/16669239732799615499/784353D54F2947AF6543A80D85ED1BD20F8006E6/","ImageSecondaryURL":"https://steamusercontent-a.akamaihd.net/ugc/31070583465015414/00568572653C758BE59FDA55ACA8B86C555C3942/","ImageScalar":1.0,"WidthScale":0.0,"CustomTile":{"Type":3,"Thickness":0.1,"Stackable":false,"Stretch":true}},"LuaScript":"","LuaScriptState":"","XmlUI":""}]]},{move_to={ 0.900002, 0.099993, -1.159487 }, json=[[{"GUID":"28e71d","Name":"Custom_Tile","Transform":{"posX":-22.4799976,"posY":1.57999337,"posZ":15.8705139,"rotX":0.0008162064,"rotY":0.0101125687,"rotZ":-8.47091E-05,"scaleX":1.8,"scaleY":1.0,"scaleZ":1.8},"Nickname":"Sven the Terrible's Realm","Description":"","GMNotes":"","AltLookAngle":{"x":0.0,"y":0.0,"z":0.0},"ColorDiffuse":{"r":0.309798837,"g":0.0,"b":0.007843138},"LayoutGroupSortIndex":0,"Value":0,"Locked":false,"Grid":true,"Snap":true,"IgnoreFoW":false,"MeasureMovement":false,"DragSelectable":true,"Autoraise":true,"Sticky":true,"Tooltip":true,"GridProjection":false,"HideWhenFaceDown":false,"Hands":false,"CustomImage":{"ImageURL":"https://steamusercontent-a.akamaihd.net/ugc/15850528289552368697/318746DEE778641327E0CBEBFE7565C758F7ADFD/","ImageSecondaryURL":"https://steamusercontent-a.akamaihd.net/ugc/31064880280343116/7AF552BB251ED05E25A5C47DC0E8E15D347478D0/","ImageScalar":1.0,"WidthScale":0.0,"CustomTile":{"Type":0,"Thickness":0.1,"Stackable":false,"Stretch":true}},"LuaScript":"","LuaScriptState":"","XmlUI":""}]]},{move_to={ 6.380081, 0.15, -4.269997 }, json=[[{"GUID":"526d09","Name":"Custom_Token","Transform":{"posX":-16.999918,"posY":1.63000035,"posZ":12.760004,"rotX":-4.592176E-06,"rotY":0.0104941428,"rotZ":-6.27516647E-06,"scaleX":0.4,"scaleY":1.0,"scaleZ":0.4},"Nickname":"Power","Description":"","GMNotes":"","AltLookAngle":{"x":0.0,"y":0.0,"z":0.0},"ColorDiffuse":{"r":1.0,"g":1.0,"b":1.0},"LayoutGroupSortIndex":0,"Value":0,"Locked":false,"Grid":true,"Snap":true,"IgnoreFoW":false,"MeasureMovement":false,"DragSelectable":true,"Autoraise":true,"Sticky":true,"Tooltip":true,"GridProjection":false,"HideWhenFaceDown":false,"Hands":false,"CustomImage":{"ImageURL":"https://steamusercontent-a.akamaihd.net/ugc/2446096078273155089/169D02643B36A59BF363E156F17B037F7B7D0C58/","ImageSecondaryURL":"","ImageScalar":1.0,"WidthScale":0.0,"CustomToken":{"Thickness":0.1,"MergeDistancePixels":15.0,"StandUp":false,"Stackable":false}},"LuaScript":"CONFIG = {\n    MIN_VALUE = 0,\n    MAX_VALUE = 999,\n    FONT_COLOR = {0,0,0,95},\n    FONT_SIZE = 1,\n    COLOR_HEX = \"#000000\",\n    TOOLTIP_SHOW = true,\n    VALUE = 0\n}\nINJECTED_COUNTER = true\n\n\nfunction onload(saved_data)\n    if saved_data ~= \"\" then\n        local loaded_data = JSON.decode(saved_data)\n        CONFIG = loaded_data\n    end\n    createAll()\nend\n\nfunction updateSave()\n    saved_data = JSON.encode(CONFIG)\n    self.script_state = saved_data\nend\n\nfunction createAll()\n    if CONFIG.TOOLTIP_SHOW then\n        ttText = self.getName().. \": \" .. CONFIG.VALUE\n    else\n        ttText = self.getName()\n    end\n    local scale = {x=1.5, y=1.5, z=1.5}\n    local thickness = self.getBoundsNormalized().size.y\n    if self.name == \"Custom_Tile\" then\n        thickness = thickness*2\n        scale = {0.75, 0.75, 0.75}\n    end\n    self.createButton({\n      label=tostring(CONFIG.VALUE),\n      click_function=\"add_subtract\",\n      tooltip=ttText,\n      function_owner=self,\n      position={0, thickness/2+0.1,0},\n      height=600,\n      width=1000,\n      alignment = 3,\n      scale=scale,\n      font_size=CONFIG.FONT_SIZE,\n      font_color=CONFIG.FONT_COLOR,\n      color={0,0,0,0}\n      })\n\n    self.createInput({\n        value = self.getName(),\n        input_function = \"editName\",\n        tooltip=ttText,\n        label = \"\",\n        function_owner = self,\n        alignment = 3,\n        position = {0,thickness/2+0.1,0},\n        width = 1,\n        height = 1,\n        font_size = CONFIG.FONT_SIZE/3,\n        scale={x=1, y=1, z=1},\n        font_color= CONFIG.FONT_COLOR,\n        color = {0,0,0,0}\n        })\n\n    setTooltips()\nend\n\nfunction editName(_obj, _string, value)\n    self.setName(value)\n    setTooltips()\nend\n\nfunction add_subtract(_obj, _color, alt_click)\n    mod = alt_click and -1 or 1\n    new_value = math.min(math.max(CONFIG.VALUE + mod, CONFIG.MIN_VALUE), CONFIG.MAX_VALUE)\n    if CONFIG.VALUE ~= new_value then\n        CONFIG.VALUE = new_value\n        updateVal()\n        updateSave()\n    end\nend\n\nfunction updateVal()\n    self.editButton({\n        index = 0,\n        label = tostring(CONFIG.VALUE)\n        })\n    setTooltips()\nend\n\nfunction setTooltips()\n    if CONFIG.TOOLTIP_SHOW then\n        ttText = self.getName().. \": \" .. CONFIG.VALUE\n    else\n        ttText = self.getName()\n    end\n\n    self.editInput({\n        index = 0,\n        value = self.getName(),\n        tooltip = ttText\n        })\n    self.editButton({\n        index = 0,\n        value = tostring(CONFIG.VALUE),\n        tooltip = ttText\n        })\nend","LuaScriptState":"{\"COLOR_HEX\":\"#FFFFFF\",\"FONT_COLOR\":[1,0.906,0.408,100],\"FONT_SIZE\":600,\"MAX_VALUE\":999,\"MIN_VALUE\":0,\"TOOLTIP_SHOW\":true,\"VALUE\":0}","XmlUI":""}]]},{move_to={ -6.869919, 0.193141, -1.229997 }, json=[[{"GUID":"10bfeb","Name":"Deck","Transform":{"posX":-30.249918,"posY":1.67314112,"posZ":15.800004,"rotX":-7.637147E-09,"rotY":0.0105007086,"rotZ":180.0,"scaleX":1.0,"scaleY":1.0,"scaleZ":1.0},"Nickname":"Sven The Terrible's Fate Deck","Description":"","GMNotes":"","AltLookAngle":{"x":0.0,"y":0.0,"z":0.0},"ColorDiffuse":{"r":0.713235259,"g":0.713235259,"b":0.713235259},"LayoutGroupSortIndex":0,"Value":0,"Locked":false,"Grid":true,"Snap":true,"IgnoreFoW":false,"MeasureMovement":false,"DragSelectable":true,"Autoraise":true,"Sticky":true,"Tooltip":true,"GridProjection":false,"HideWhenFaceDown":true,"Hands":false,"SidewaysCard":false,"DeckIDs":[12479301,12479301,12479502,12479111,12479111,12479113,12479506,12479100,12479101,12479102,12479103,12479104,12479312,12479106,12479107],"CustomDeck":{"124793":{"FaceURL":"https://steamusercontent-a.akamaihd.net/ugc/17319173074096910512/1F98AA580EAF86E2D78371452D080E56A1FE1BE0/","BackURL":"https://steamusercontent-a.akamaihd.net/ugc/31064975367331102/2AC847DC9862B817279575D8C4B49A9E326E91B9/","NumWidth":10,"NumHeight":7,"BackIsHidden":true,"UniqueBack":false,"Type":0},"124795":{"FaceURL":"https://steamusercontent-a.akamaihd.net/ugc/14839609695347519334/FC9B549F55D7E95253E280CB02BCD5B637C6E74D/","BackURL":"https://steamusercontent-a.akamaihd.net/ugc/31064975367331102/2AC847DC9862B817279575D8C4B49A9E326E91B9/","NumWidth":10,"NumHeight":7,"BackIsHidden":true,"UniqueBack":false,"Type":0},"124791":{"FaceURL":"https://steamusercontent-a.akamaihd.net/ugc/11325850509743137623/88C25EFF081E252CCA6A0C33893EFE188A88544A/","BackURL":"https://steamusercontent-a.akamaihd.net/ugc/31064975367331102/2AC847DC9862B817279575D8C4B49A9E326E91B9/","NumWidth":10,"NumHeight":7,"BackIsHidden":true,"UniqueBack":false,"Type":0}},"LuaScript":"","LuaScriptState":"","XmlUI":"","ContainedObjects":[{"GUID":"ea3487","Name":"Card","Transform":{"posX":0.748068035,"posY":2.20371652,"posZ":17.9670372,"rotX":2.20709777,"rotY":180.288986,"rotZ":179.995
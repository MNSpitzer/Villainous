{move_to={ 0.900055, 0.099997, -1.159882 }, json=[[{"GUID":"37c74d","Name":"Custom_Tile","Transform":{"posX":71.52006,"posY":1.5799973,"posZ":15.8701191,"rotX":2.44774637E-05,"rotY":0.0119974623,"rotZ":-3.51998642E-05,"scaleX":1.8,"scaleY":1.0,"scaleZ":1.8},"Nickname":"Queen Victoria's Realm","Description":"","GMNotes":"","AltLookAngle":{"x":0.0,"y":0.0,"z":0.0},"ColorDiffuse":{"r":0.388232827,"g":0.250977933,"b":0.133330971},"LayoutGroupSortIndex":0,"Value":0,"Locked":false,"Grid":true,"Snap":true,"IgnoreFoW":false,"MeasureMovement":false,"DragSelectable":true,"Autoraise":true,"Sticky":true,"Tooltip":true,"GridProjection":false,"HideWhenFaceDown":false,"Hands":false,"CustomImage":{"ImageURL":"https://steamusercontent-a.akamaihd.net/ugc/62584369538227930/DA6A999202F0BE393CA447A37DA1EAC4AF2FD983/","ImageSecondaryURL":"https://steamusercontent-a.akamaihd.net/ugc/2501268517184118822/747F91D4E029838BD29514EFDA4D035B95B7026E/","ImageScalar":1.0,"WidthScale":0.0,"CustomTile":{"Type":0,"Thickness":0.1,"Stackable":false,"Stretch":true}},"LuaScript":"","LuaScriptState":"","XmlUI":""}]]},{move_to={ 3.933212, 0.155089, 1.886677 }, json=[[{"GUID":"109634","Name":"Custom_Tile","Transform":{"posX":74.553215,"posY":1.6350888,"posZ":18.9166775,"rotX":2.06060886,"rotY":0.0147196231,"rotZ":5.17873232E-05,"scaleX":1.53204679,"scaleY":1.0,"scaleZ":1.53204679},"Nickname":"The QV1","Description":"","GMNotes":"","AltLookAngle":{"x":0.0,"y":0.0,"z":0.0},"ColorDiffuse":{"r":0.388233274,"g":0.250978351,"b":0.133331388},"LayoutGroupSortIndex":0,"Value":0,"Locked":false,"Grid":true,"Snap":true,"IgnoreFoW":false,"MeasureMovement":false,"DragSelectable":true,"Autoraise":true,"Sticky":true,"Tooltip":true,"GridProjection":false,"HideWhenFaceDown":false,"Hands":false,"CustomImage":{"ImageURL":"https://steamusercontent-a.akamaihd.net/ugc/2444972799636365196/A2796880AFFA7B8BA526EB7AF4D76BED16D2EC83/","ImageSecondaryURL":"https://steamusercontent-a.akamaihd.net/ugc/2444972799636365196/A2796880AFFA7B8B